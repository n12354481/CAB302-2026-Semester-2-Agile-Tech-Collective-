<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Authentication.LoginController"
            prefHeight="500.0"
            prefWidth="700.0">

    <!-- Green header -->
    <Pane prefHeight="90.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0"
          style="-fx-background-color: #237A6B;">

        <Label text="Stem App"
               layoutX="290.0"
               layoutY="28.0"
               style="-fx-font-size: 25px;
                      -fx-font-weight: bold;
                      -fx-text-fill: white;"/>
    </Pane>

    <!-- Username -->
    <Label text="Username"
           layoutX="200.0"
           layoutY="145.0"
           style="-fx-font-size: 14px;
                  -fx-font-weight: bold;"/>

    <TextField fx:id="usernameField"
               layoutX="200.0"
               layoutY="170.0"
               prefWidth="300.0"
               promptText="Enter username"/>

    <!-- Password -->
    <Label text="Password"
           layoutX="200.0"
           layoutY="225.0"
           style="-fx-font-size: 14px;
                  -fx-font-weight: bold;"/>

    <PasswordField fx:id="passwordField"
                   layoutX="200.0"
                   layoutY="250.0"
                   prefWidth="300.0"
                   promptText="Enter password"/>

    <!-- Error/success messages -->
    <Label fx:id="messageLabel"
           layoutX="200.0"
           layoutY="295.0"
           prefWidth="300.0"
           alignment="CENTER"
           wrapText="true"/>

    <!-- Sign in -->
    <Button text="Sign in"
            layoutX="300.0"
            layoutY="335.0"
            prefWidth="100.0"
            onAction="#handleLogin"/>

    <!-- Registration -->
    <Label text="Haven't registered yet?"
           layoutX="275.0"
           layoutY="405.0"/>

    <Button text="Register"
            layoutX="300.0"
            layoutY="430.0"
            prefWidth="100.0"
            onAction="#goToRegister"/>

</AnchorPane>