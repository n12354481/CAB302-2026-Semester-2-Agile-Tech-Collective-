<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.cab302project.Authentication.RegistrationController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            stylesheets="@Theme.css"
            styleClass="scroll-clear">

    <content>

        <VBox alignment="TOP_CENTER"
              spacing="0"
              minHeight="600.0"
              styleClass="theme">

            <!-- Header -->
            <StackPane prefHeight="90.0"
                       minHeight="90.0"
                       maxHeight="90.0"
                       maxWidth="Infinity"
                       styleClass="sidebar">

                <Label text="Stemwise" styleClass="brand"/>

            </StackPane>

            <!-- Registration form -->
            <VBox alignment="TOP_LEFT"
                  spacing="10.0"
                  maxWidth="300.0">

                <padding>
                    <Insets top="30.0"
                            right="0.0"
                            bottom="25.0"
                            left="0.0"/>
                </padding>

                <!-- Email -->
                <Label text="Email" styleClass="field-label"/>

                <TextField fx:id="emailField"
                           maxWidth="Infinity"
                           prefHeight="32.0"
                           promptText="Enter email"/>

                <Region prefHeight="8.0"/>

                <!-- Username -->
                <Label text="Username" styleClass="field-label"/>

                <TextField fx:id="usernameField"
                           maxWidth="Infinity"
                           prefHeight="32.0"
                           promptText="Enter username"/>

                <Region prefHeight="8.0"/>

                <!-- Password -->
                <Label text="Password" styleClass="field-label"/>

                <PasswordField fx:id="passwordField"
                               maxWidth="Infinity"
                               prefHeight="32.0"
                               promptText="Enter password"/>

                <Region prefHeight="8.0"/>

                <!-- Confirm password -->
                <Label text="Confirm Password" styleClass="field-label"/>

                <PasswordField fx:id="confirmPasswordField"
                               maxWidth="Infinity"
                               prefHeight="32.0"
                               promptText="Re-enter password"/>

                <!-- Error/success message -->
                <Label fx:id="messageLabel"
                       maxWidth="Infinity"
                       minHeight="30.0"
                       alignment="CENTER"
                       wrapText="true"/>

                <!-- Register button -->
                <HBox alignment="CENTER">

                    <Button text="Register"
                            prefWidth="100.0"
                            styleClass="btn-primary"
                            onAction="#handleRegister"/>

                </HBox>

                <Region prefHeight="10.0"/>

                <!-- Back to login -->
                <Label text="Already have an account?"
                       maxWidth="Infinity"
                       alignment="CENTER"/>

                <HBox alignment="CENTER">

                    <Button text="Sign In"
                            prefWidth="100.0"
                            styleClass="btn-secondary"
                            onAction="#goToLogin"/>

                </HBox>

            </VBox>

        </VBox>

    </content>

</ScrollPane>