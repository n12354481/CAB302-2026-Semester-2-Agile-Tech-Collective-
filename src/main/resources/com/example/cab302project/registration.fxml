<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>

<AnchorPane xmlns="http://javafx.com/javafx" styleClass="theme" stylesheets="@Theme.css"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.cab302project.Authentication.RegistrationController"
            prefHeight="550.0"
            prefWidth="700.0">

    <!-- Header -->
    <Pane prefHeight="90.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0"
          styleClass="sidebar">

        <Label text="Stem App"
               layoutX="290.0"
               layoutY="28.0"
               styleClass="brand"/>
    </Pane>

    <!-- Email -->
    <Label text="Email"
           layoutX="200.0"
           layoutY="125.0"
           styleClass="field-label"/>

    <TextField fx:id="emailField"
               layoutX="200.0"
               layoutY="150.0"
               prefWidth="300.0"
               promptText="Enter email"/>

    <!-- Username -->
    <Label text="Username"
           layoutX="200.0"
           layoutY="200.0"
           styleClass="field-label"/>

    <TextField fx:id="usernameField"
               layoutX="200.0"
               layoutY="225.0"
               prefWidth="300.0"
               promptText="Enter username"/>

    <!-- Password -->
    <Label text="Password"
           layoutX="200.0"
           layoutY="275.0"
           styleClass="field-label"/>

    <PasswordField fx:id="passwordField"
                   layoutX="200.0"
                   layoutY="300.0"
                   prefWidth="300.0"
                   promptText="Enter password"/>

    <!-- Confirm password -->
    <Label text="Confirm Password"
           layoutX="200.0"
           layoutY="350.0"
           styleClass="field-label"/>

    <PasswordField fx:id="confirmPasswordField"
                   layoutX="200.0"
                   layoutY="375.0"
                   prefWidth="300.0"
                   promptText="Re-enter password"/>

    <!-- Messages -->
    <Label fx:id="messageLabel"
           layoutX="200.0"
           layoutY="415.0"
           prefWidth="300.0"
           alignment="CENTER"
           wrapText="true"/>

    <!-- Register -->
    <Button text="Register"
            layoutX="300.0"
            layoutY="450.0"
            prefWidth="100.0"
            styleClass="btn-primary"
            onAction="#handleRegister"/>

    <!-- Back to login -->
    <Label text="Already have an account?"
           layoutX="265.0"
           layoutY="495.0"/>

    <Button text="Sign In"
            layoutX="300.0"
            layoutY="515.0"
            prefWidth="100.0"
            styleClass="btn-secondary"
            onAction="#goToLogin"/>

</AnchorPane>