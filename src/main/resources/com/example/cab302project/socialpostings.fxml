<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cab302project.SocialPostingsController" stylesheets="@socialstyle.css" styleClass="social-root">

    <top>
        <VBox styleClass="header-card">
            <padding>
                <Insets top="16" right="20" bottom="16" left="20"/>
            </padding>
            <BorderPane.margin>
                <Insets bottom="16"/>
            </BorderPane.margin>

            <Label text="STEM Social Community" styleClass="header-title"/>
            <Label text="Connect and discover like-minded students in your city!" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox styleClass="feed-card">

            <!-- filter bar for users -->
            <HBox styleClass="filter-bar" spacing="8" alignment="CENTER_LEFT">
                <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                <Label text="Filter posts by:" styleClass="filter-label"/>
                <Button text="CLEAR FILTERS" styleClass="clear-filters-btn"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink text="FILTERS" styleClass="filters-link"/>
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="feed-scroll" VBox.vgrow="ALWAYS">
                <VBox styleClass="post-card">
                    <Region styleClass="post-image" prefHeight="160"/>
                    <VBox spacing="6">
                        <padding><Insets top="10" right="14" bottom="14" left="14"/></padding>
                        <Label text="Brisbane Monthly Hackathon" styleClass="post-title"/>
                        <Label wrapText="true" styleClass="post-desc"
                               text="Join us for a monthly hackathon! On the first of every weekend every month, we, the Brisbane Code Inspirers, host our hackathon at the University of Queensland."/>
                        <HBox spacing="8">
                            <Button text="Register Here!" styleClass="register-btn"/>
                            <Button text="✓ Interested" styleClass="interested-btn"/>
                        </HBox>
                    </VBox>
                </VBox>

            </ScrollPane>

        </VBox>
    </center>

</BorderPane>