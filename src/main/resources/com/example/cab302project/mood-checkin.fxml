<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.cab302project.MoodForm.CheckInController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            style="-fx-background: #f8f8f8;
                   -fx-background-color: #f8f8f8;">

    <!-- Toggle groups used by the controller -->
    <fx:define>
        <ToggleGroup fx:id="emotionGroup"/>
        <ToggleGroup fx:id="sleepGroup"/>
    </fx:define>

    <content>

        <VBox spacing="22.0"
              fillWidth="true"
              style="-fx-background-color: #f8f8f8;">

            <padding>
                <Insets top="30.0"
                        right="35.0"
                        bottom="35.0"
                        left="35.0"/>
            </padding>

            <!-- ==================== TITLE ==================== -->

            <Label text="Emotions and Wellbeing Check"
                   style="-fx-font-size: 24px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #222222;"/>


            <!-- ==================== EMOTION ==================== -->

            <VBox spacing="12.0">

                <Label text="How are you feeling today?"
                       style="-fx-font-size: 17px;
                              -fx-font-weight: bold;"/>

                <GridPane hgap="12.0"
                          vgap="12.0">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="20.0"/>
                        <ColumnConstraints percentWidth="20.0"/>
                        <ColumnConstraints percentWidth="20.0"/>
                        <ColumnConstraints percentWidth="20.0"/>
                        <ColumnConstraints percentWidth="20.0"/>
                    </columnConstraints>

                    <RadioButton fx:id="strugglingRadio"
                                 text="Struggling"
                                 toggleGroup="$emotionGroup"
                                 maxWidth="Infinity"
                                 prefHeight="45.0"
                                 alignment="CENTER"
                                 GridPane.columnIndex="0"
                                 GridPane.rowIndex="0"
                                 style="-fx-background-color: #F2F2F2;
                                        -fx-background-radius: 12;
                                        -fx-padding: 10;"/>

                    <RadioButton fx:id="notGreatRadio"
                                 text="Not Great"
                                 toggleGroup="$emotionGroup"
                                 maxWidth="Infinity"
                                 prefHeight="45.0"
                                 alignment="CENTER"
                                 GridPane.columnIndex="1"
                                 GridPane.rowIndex="0"
                                 style="-fx-background-color: #F2F2F2;
                                        -fx-background-radius: 12;
                                        -fx-padding: 10;"/>

                    <RadioButton fx:id="okayRadio"
                                 text="Okay"
                                 toggleGroup="$emotionGroup"
                                 maxWidth="Infinity"
                                 prefHeight="45.0"
                                 alignment="CENTER"
                                 GridPane.columnIndex="2"
                                 GridPane.rowIndex="0"
                                 style="-fx-background-color: #F2F2F2;
                                        -fx-background-radius: 12;
                                        -fx-padding: 10;"/>

                    <RadioButton fx:id="goodRadio"
                                 text="Good"
                                 toggleGroup="$emotionGroup"
                                 maxWidth="Infinity"
                                 prefHeight="45.0"
                                 alignment="CENTER"
                                 GridPane.columnIndex="3"
                                 GridPane.rowIndex="0"
                                 style="-fx-background-color: #F2F2F2;
                                        -fx-background-radius: 12;
                                        -fx-padding: 10;"/>

                    <RadioButton fx:id="greatRadio"
                                 text="Great"
                                 toggleGroup="$emotionGroup"
                                 maxWidth="Infinity"
                                 prefHeight="45.0"
                                 alignment="CENTER"
                                 GridPane.columnIndex="4"
                                 GridPane.rowIndex="0"
                                 style="-fx-background-color: #F2F2F2;
                                        -fx-background-radius: 12;
                                        -fx-padding: 10;"/>

                </GridPane>

            </VBox>


            <!-- ==================== SLEEP ==================== -->

            <VBox spacing="12.0">

                <Label text="How much sleep did you get?"
                       style="-fx-font-size: 17px;
                              -fx-font-weight: bold;"/>

                <GridPane hgap="12.0"
                          vgap="12.0">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="25.0"/>
                        <ColumnConstraints percentWidth="25.0"/>
                        <ColumnConstraints percentWidth="25.0"/>
                        <ColumnConstraints percentWidth="25.0"/>
                    </columnConstraints>

                    <RadioButton fx:id="noSleepRadio"
                                 text="No Sleep&#10;(0 Hours)"
                                 toggleGroup="$sleepGroup"
                                 maxWidth="Infinity"
                                 prefHeight="60.0"
                                 alignment="CENTER"
                                 wrapText="true"
                                 GridPane.columnIndex="0"
                                 GridPane.rowIndex="0"
                                 style="-fx-background-color: #F2F2F2;
                                        -fx-background-radius: 12;
                                        -fx-padding: 10;"/>

                    <RadioButton fx:id="lessSleepRadio"
                                 text="Less Sleep&#10;(1-5 Hours)"
                                 toggleGroup="$sleepGroup"
                                 maxWidth="Infinity"
                                 prefHeight="60.0"
                                 alignment="CENTER"
                                 wrapText="true"
                                 GridPane.columnIndex="1"
                                 GridPane.rowIndex="0"
                                 style="-fx-background-color: #F2F2F2;
                                        -fx-background-radius: 12;
                                        -fx-padding: 10;"/>

                    <RadioButton fx:id="goodSleepRadio"
                                 text="Good Sleep&#10;(6-8 Hours)"
                                 toggleGroup="$sleepGroup"
                                 maxWidth="Infinity"
                                 prefHeight="60.0"
                                 alignment="CENTER"
                                 wrapText="true"
                                 GridPane.columnIndex="2"
                                 GridPane.rowIndex="0"
                                 style="-fx-background-color: #F2F2F2;
                                        -fx-background-radius: 12;
                                        -fx-padding: 10;"/>

                    <RadioButton fx:id="excellentSleepRadio"
                                 text="Excellent Sleep&#10;(9+ Hours)"
                                 toggleGroup="$sleepGroup"
                                 maxWidth="Infinity"
                                 prefHeight="60.0"
                                 alignment="CENTER"
                                 wrapText="true"
                                 GridPane.columnIndex="3"
                                 GridPane.rowIndex="0"
                                 style="-fx-background-color: #F2F2F2;
                                        -fx-background-radius: 12;
                                        -fx-padding: 10;"/>

                </GridPane>

            </VBox>


            <!-- ==================== WATER ==================== -->

            <VBox spacing="12.0">

                <Label text="How much water have you drunk in the past 24 hours?"
                       wrapText="true"
                       style="-fx-font-size: 17px;
                              -fx-font-weight: bold;"/>

                <HBox spacing="10.0"
                      alignment="CENTER_LEFT">

                    <ComboBox fx:id="waterComboBox"
                              prefWidth="130.0"
                              prefHeight="35.0"
                              promptText="Select"/>

                    <Label text="Litres"
                           style="-fx-font-size: 14px;"/>

                </HBox>

            </VBox>


            <!-- ==================== STUDY STRESS ==================== -->

            <VBox spacing="10.0">

                <Label text="Study stress level?"
                       style="-fx-font-size: 17px;
                              -fx-font-weight: bold;"/>

                <Slider fx:id="stressSlider"
                        maxWidth="Infinity"
                        min="1.0"
                        max="5.0"
                        value="3.0"
                        blockIncrement="1.0"
                        majorTickUnit="1.0"
                        minorTickCount="0"
                        snapToTicks="true"/>

                <HBox>

                    <Label text="Not Stressed"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="Very Stressed"/>

                </HBox>

            </VBox>


            <!-- ==================== MOODS ==================== -->

            <VBox spacing="12.0">

                <Label text="Words that describe your mood right now?"
                       wrapText="true"
                       style="-fx-font-size: 17px;
                              -fx-font-weight: bold;"/>

                <GridPane hgap="12.0"
                          vgap="12.0">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="16.666"/>
                        <ColumnConstraints percentWidth="16.666"/>
                        <ColumnConstraints percentWidth="16.666"/>
                        <ColumnConstraints percentWidth="16.666"/>
                        <ColumnConstraints percentWidth="16.666"/>
                        <ColumnConstraints percentWidth="16.666"/>
                    </columnConstraints>

                    <CheckBox fx:id="happyCheckBox"
                              text="Happy"
                              maxWidth="Infinity"
                              prefHeight="42.0"
                              alignment="CENTER"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="0"
                              style="-fx-background-color: #F2F2F2;
                                     -fx-background-radius: 12;
                                     -fx-padding: 10;"/>

                    <CheckBox fx:id="calmCheckBox"
                              text="Calm"
                              maxWidth="Infinity"
                              prefHeight="42.0"
                              alignment="CENTER"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="0"
                              style="-fx-background-color: #F2F2F2;
                                     -fx-background-radius: 12;
                                     -fx-padding: 10;"/>

                    <CheckBox fx:id="tiredCheckBox"
                              text="Tired"
                              maxWidth="Infinity"
                              prefHeight="42.0"
                              alignment="CENTER"
                              GridPane.columnIndex="2"
                              GridPane.rowIndex="0"
                              style="-fx-background-color: #F2F2F2;
                                     -fx-background-radius: 12;
                                     -fx-padding: 10;"/>

                    <CheckBox fx:id="anxiousCheckBox"
                              text="Anxious"
                              maxWidth="Infinity"
                              prefHeight="42.0"
                              alignment="CENTER"
                              GridPane.columnIndex="3"
                              GridPane.rowIndex="0"
                              style="-fx-background-color: #F2F2F2;
                                     -fx-background-radius: 12;
                                     -fx-padding: 10;"/>

                    <CheckBox fx:id="sadCheckBox"
                              text="Sad"
                              maxWidth="Infinity"
                              prefHeight="42.0"
                              alignment="CENTER"
                              GridPane.columnIndex="4"
                              GridPane.rowIndex="0"
                              style="-fx-background-color: #F2F2F2;
                                     -fx-background-radius: 12;
                                     -fx-padding: 10;"/>

                    <CheckBox fx:id="sleepyCheckBox"
                              text="Sleepy"
                              maxWidth="Infinity"
                              prefHeight="42.0"
                              alignment="CENTER"
                              GridPane.columnIndex="5"
                              GridPane.rowIndex="0"
                              style="-fx-background-color: #F2F2F2;
                                     -fx-background-radius: 12;
                                     -fx-padding: 10;"/>

                </GridPane>

            </VBox>


            <!-- ==================== MESSAGE ==================== -->

            <Label fx:id="messageLabel"
                   text=""
                   maxWidth="Infinity"
                   wrapText="true"
                   style="-fx-font-size: 13px;"/>


            <!-- ==================== SUBMIT ==================== -->

            <Button fx:id="submitButton"
                    prefWidth="150.0"
                    prefHeight="42.0"
                    text="Submit"
                    onAction="#handleSubmit"
                    style="-fx-background-color: #2A9D8F;
                           -fx-background-radius: 10;
                           -fx-text-fill: white;
                           -fx-font-size: 15px;
                           -fx-font-weight: bold;"/>

        </VBox>

    </content>

</ScrollPane>