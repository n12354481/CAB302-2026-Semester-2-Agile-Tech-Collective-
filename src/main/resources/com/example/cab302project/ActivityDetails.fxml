<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="600" prefWidth="650" style="-fx-bacjground: white; -fx-background-color: white;" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cab302project.Activities.ActivitiesController">

    <fx:define>
        <ToggleGroup fx:id="durationGroup"/>
    </fx:define>

    <content>
        <VBox spacing="16">
            <padding>
                <Insets top="25." right="30" bottom="25" left="30"/>
            </padding>

            <Button text="← Back" onAction="#onBackClicked"/>

            <StackPane prefHeight="220" minHeight="220" style="-fx-background-color: #E8EEEE; -fx-background-radius: 15;">
                <ImageView fx:id="activityImage" fitWidth="480" fitHeight="220" preserveRatio="true"/>
                <Label fx:id="imagePlaceholder"/>
            </StackPane>

            <Label fx:id="activityName" wrapText="true" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Label fx:id="categoryLabel" style="-fx-background-color: #E8EEEE; -fx-padding: 4 10; -fx-background-radius: 12;"/>

            <Label fx:id="descriptionLabel" wrapText="true" style="-fx-font-size: 14px;"/>

            <Label fx:id="goalLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <FlowPane hgap="20" vgap="10">
                <RadioButton text="15 min" toggleGroup="$durationGroup"/>
                <RadioButton text="30 mins" toggleGroup="$durationGroup"/>
                <RadioButton fx:id="customDuration" text="Custom" toggleGroup="$durationGroup"/>
            </FlowPane>

            <TextField fx:id="customMinutes" promptText="Duration in minutes" maxWidth="200"/>

            <Button text="Select activity" onAction="#onSelectActivityClicked" style="-fx-background-color: #E8EEEE;"/>

        </VBox>
    </content>

</ScrollPane>
