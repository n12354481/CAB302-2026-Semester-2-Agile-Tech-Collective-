<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.cab302project.Dashboard.DashboardController"
            prefHeight="400.0" prefWidth="600.0">
    <BorderPane AnchorPane.leftAnchor="0"
                AnchorPane.topAnchor="0"
                AnchorPane.rightAnchor="0"
                AnchorPane.bottomAnchor="0">
        <top>
            <VBox fillWidth="true"
                  spacing="20"
                  style="-fx-background-color: #fff">
                <HBox style="-fx-background-color: #DEF3F0">
                    <padding>
                        <Insets top="20" left="20" right="20" bottom="50"/>
                    </padding>
                    <Label text="THis is the first box"/>
                </HBox>

                <VBox spacing="20">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <HBox style="-fx-background-color: #C5C6C7;
                     -fx-background-radius: 15px;
                     -fx-border-radius: 15px;
                     -fx-border-width: 5px;
                     -fx-border-color: #C5C6C7;">
                        <padding>
                            <Insets top="10" left="20" right="20" bottom="10"/>
                        </padding>
                        <Label text="THis is the second box"/>
                    </HBox>

                    <HBox style="-fx-background-color: #C5C6C7;
                     -fx-background-radius: 15px;
                     -fx-border-radius: 15px;
                     -fx-border-width: 5px;
                     -fx-border-color: #C5C6C7;">
                        <padding>
                            <Insets top="10" left="20" right="20" bottom="10"/>
                        </padding>
                        <Label text="THis is the third box"/>
                    </HBox>
                </VBox>
            </VBox>
        </top>
        <center>
            <HBox spacing="20"
                  VBox.vgrow="ALWAYS"
                  fillHeight="true"
                  alignment="TOP_CENTER">
                <padding>
                    <Insets top="20" bottom="20" left="20" right="20"/>
                </padding>

                <!--AI Rec-->
                <VBox HBox.hgrow="ALWAYS"
                      spacing="10"
                      fillWidth="true">

                    <Label text="AI Recommendations"
                           alignment="CENTER_LEFT"
                           style="-fx-font-size: 20;
                                  -fx-font-weight: bold;"/>
                    <VBox VBox.vgrow="ALWAYS"
                          spacing="20"
                          style="-fx-background-color: #fff;
                                 -fx-background-radius: 15;
                                 -fx-border-radius: 20;">
                        <!--                        <Region style="-fx-background-color: #D9A441;-->
                        <!--                                       -fx-padding: 0 0 4 0;">-->
                        <VBox VBox.vgrow="ALWAYS"
                              spacing="30">
                            <padding>
                                <Insets top="15" right="15" bottom="15" left="15"/>
                            </padding>
                            <VBox spacing="25"
                                  style="-fx-background-color: #F2FFFD;
                                 -fx-background-radius: 15;
                                 -fx-border-radius: 20;"
                                  prefHeight="130">

                                <Label text="First"/>
                            </VBox>
                        </VBox>
                        <!--                        </Region>-->
                        <VBox VBox.vgrow="ALWAYS"
                              spacing="30">
                            <padding>
                                <Insets top="15" right="15" bottom="15" left="15"/>
                            </padding>
                            <VBox spacing="25"
                                  style="-fx-background-color: #F2FFFD;
                                 -fx-background-radius: 15;
                                 -fx-border-radius: 20;"
                                  prefHeight="130">

                                <Label text="Second"/>
                            </VBox>
                        </VBox>

                        <VBox VBox.vgrow="ALWAYS"
                              alignment="BOTTOM_LEFT"
                              spacing="25">
<!--                            <padding>-->
<!--                                <Insets top="15" right="15" bottom="15" left="15"/>-->
<!--                            </padding>-->
                            <VBox spacing="30"
                                  style="-fx-background-color: #F2FFFD;
                                 -fx-background-radius: 15;
                                 -fx-border-radius: 20;"
                                  prefHeight="130">

                                <Label text="Third"/>
                            </VBox>
                        </VBox>

                    </VBox>
                </VBox>

                <!--Overall Stats-->
                <VBox HBox.hgrow="ALWAYS"
                      fillWidth="true"
                      spacing="10">

                    <Label text="Overall Statistics"
                           style="-fx-font-size: 20;
                                  -fx-font-weight: bold;"/>

                    <VBox VBox.vgrow="ALWAYS"
                          fillWidth="true"
                          spacing="0"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 15;">

                        <VBox VBox.vgrow="ALWAYS"
                              spacing="30">
                            <padding>
                                <Insets top="15" right="15" bottom="15" left="15"/>
                            </padding>
                            <HBox spacing="25"
                                  style="-fx-background-color: #white;
                                 -fx-background-radius: 15;
                                 -fx-border-radius: 20;"
                                  prefHeight="130">

                                <Label text="Registered Events"/>
                            </HBox>
                        </VBox>

                        <StackPane alignment="BOTTOM_RIGHT"
                                       VBox.vgrow="ALWAYS">
                                <ProgressIndicator progress="0.25"
                                                   prefWidth="250"
                                                   prefHeight="250"
                                                   maxHeight="250"
                                                   maxWidth="250"
                                                   style="-fx-progress-color: #2BB7A9;
                                                  -fx-background-color: transparent;"/>
                            </StackPane>
                    </VBox>
                </VBox>
            </HBox>
        </center>
    </BorderPane>
</AnchorPane>