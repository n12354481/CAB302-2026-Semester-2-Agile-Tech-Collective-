<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.cab302project.MoodForm.WellbeingController"
            prefWidth="1200.0"
            prefHeight="850.0"
            style="-fx-background-color: #f8f8f8;">

    <children>

        <!-- Page title -->
        <Label text="My Wellbeing"
               layoutX="35.0"
               layoutY="30.0"
               style="-fx-font-size: 28px;
                      -fx-font-weight: bold;" />

        <!-- Temporary database check -->
        <Label fx:id="checkInCountLabel"
               text="Total check-ins: 0"
               layoutX="35.0"
               layoutY="80.0"
               style="-fx-font-size: 14px;
                      -fx-text-fill: #666666;" />

        <!-- Graph section -->
        <Label text="Mood Over Time"
               layoutX="35.0"
               layoutY="125.0"
               style="-fx-font-size: 20px;
                      -fx-font-weight: bold;" />

        <StackPane layoutX="35.0"
                   layoutY="165.0"
                   prefWidth="1080.0"
                   prefHeight="270.0"
                   style="-fx-background-color: white;
                          -fx-border-color: #999999;
                          -fx-border-radius: 15;
                          -fx-background-radius: 15;">

            <Label text="Mood graph will appear here"
                   style="-fx-text-fill: #888888;
                          -fx-font-size: 16px;" />

        </StackPane>

        <!-- Weekly emotions -->
        <Label text="Emotions experienced over the week"
               layoutX="35.0"
               layoutY="470.0"
               style="-fx-font-size: 18px;
                      -fx-font-weight: bold;" />

        <Label text="Happy"
               layoutX="55.0"
               layoutY="515.0" />

        <Label text="Calm"
               layoutX="55.0"
               layoutY="545.0" />

        <Label text="Tired"
               layoutX="55.0"
               layoutY="575.0" />

        <Label text="Anxious"
               layoutX="350.0"
               layoutY="515.0" />

        <Label text="Sad"
               layoutX="350.0"
               layoutY="545.0" />

        <Label text="Sleepy"
               layoutX="350.0"
               layoutY="575.0" />

        <!-- Insights -->
        <Label text="Insights"
               layoutX="35.0"
               layoutY="625.0"
               style="-fx-font-size: 18px;
                      -fx-font-weight: bold;" />

        <VBox layoutX="35.0"
              layoutY="665.0"
              prefWidth="280.0"
              prefHeight="100.0"
              spacing="10"
              style="-fx-background-color: white;
                     -fx-border-color: #aaaaaa;
                     -fx-padding: 15;">

            <Label text="Sleep"
                   style="-fx-font-weight: bold;" />

            <Label fx:id="sleepInsightLabel"
                   text="Not enough data" />

        </VBox>

        <VBox layoutX="350.0"
              layoutY="665.0"
              prefWidth="280.0"
              prefHeight="100.0"
              spacing="10"
              style="-fx-background-color: white;
                     -fx-border-color: #aaaaaa;
                     -fx-padding: 15;">

            <Label text="Water Intake"
                   style="-fx-font-weight: bold;" />

            <Label fx:id="waterInsightLabel"
                   text="Not enough data" />

        </VBox>

        <VBox layoutX="665.0"
              layoutY="665.0"
              prefWidth="280.0"
              prefHeight="100.0"
              spacing="10"
              style="-fx-background-color: white;
                     -fx-border-color: #aaaaaa;
                     -fx-padding: 15;">

            <Label text="Study Stress"
                   style="-fx-font-weight: bold;" />

            <Label fx:id="stressInsightLabel"
                   text="Not enough data" />

        </VBox>

        <Button text="New Check-In"
                layoutX="980.0"
                layoutY="700.0"
                prefWidth="135.0"
                prefHeight="45.0"
                onAction="#handleNewCheckIn"
                style="-fx-background-color: #2aa69a;
                       -fx-text-fill: white;
                       -fx-font-size: 15px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;" />

    </children>

</AnchorPane>