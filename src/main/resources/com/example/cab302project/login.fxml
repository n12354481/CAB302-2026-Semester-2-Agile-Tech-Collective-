<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.cab302project.Authentication.LoginController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            stylesheets="@Theme.css"
            styleClass="scroll-clear">

    <content>

        <VBox alignment="TOP_CENTER"
              spacing="0"
              minHeight="500.0"
              styleClass="theme">

            <!-- Header -->
            <StackPane prefHeight="90.0"
                       minHeight="90.0"
                       maxHeight="90.0"
                       maxWidth="Infinity"
                       styleClass="sidebar">

                <Label text="Stemwise" styleClass="brand"/>

            </StackPane>

            <!-- Login content -->
            <VBox alignment="TOP_LEFT"
                  spacing="10.0"
                  maxWidth="300.0">

                <padding>
                    <Insets top="50.0"
                            right="0.0"
                            bottom="20.0"
                            left="0.0"/>
                </padding>

                <!-- Username -->
                <Label text="Username" styleClass="field-label"/>

                <TextField fx:id="usernameField"
                           maxWidth="Infinity"
                           prefHeight="32.0"
                           promptText="Enter username"/>

                <!-- Space between fields -->
                <Region prefHeight="15.0"/>

                <!-- Password -->
                <Label text="Password" styleClass="field-label"/>

                <PasswordField fx:id="passwordField"
                               maxWidth="Infinity"
                               prefHeight="32.0"
                               promptText="Enter password"/>

                <!-- Messages -->
                <Label fx:id="messageLabel"
                       maxWidth="Infinity"
                       minHeight="30.0"
                       alignment="CENTER"
                       wrapText="true"/>

                <!-- Sign in -->
                <HBox alignment="CENTER">

                    <Button text="Sign in"
                            prefWidth="100.0"
                            styleClass="btn-primary"
                            onAction="#handleLogin"/>

                </HBox>

                <Region prefHeight="20.0"/>

                <!-- Registration -->
                <Label text="Haven't registered yet?"
                       maxWidth="Infinity"
                       alignment="CENTER"/>

                <HBox alignment="CENTER">

                    <Button text="Register"
                            prefWidth="100.0"
                            styleClass="btn-secondary"
                            onAction="#goToRegister"/>

                </HBox>

            </VBox>

        </VBox>

    </content>

</ScrollPane>