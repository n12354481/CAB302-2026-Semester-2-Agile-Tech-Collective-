<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Laid out from the Rewards Dashboard Wireframe. -->
<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.cab302project.Rewards.RewardsController"
            fitToWidth="true" styleClass="rewards" stylesheets="@Rewards.css">

    <VBox spacing="24.0">
        <padding>
            <Insets top="32.0" right="32.0" bottom="32.0" left="32.0"/>
        </padding>

        <HBox alignment="BASELINE_LEFT" spacing="12.0">
            <Label text="Rewards" styleClass="title"/>
            <Label fx:id="rangeLabel" styleClass="muted"/>
        </HBox>

        <!-- Hidden only if the database cannot be read. -->
        <VBox fx:id="summaryState" spacing="24.0" managed="false" visible="false">

            <!-- Row 1: the garden, and whichever day is picked in it. -->
            <HBox spacing="24.0">
                <!-- prefWidth 0 so the garden takes whatever the selected card leaves. -->
                <!-- The controller adds the GardenPane at the end. FXML cannot import it, because
                     it reads the capitalised Rewards package as a class name. -->
                <VBox fx:id="gardenCard" styleClass="card" spacing="12.0" HBox.hgrow="ALWAYS"
                      minWidth="360.0" prefWidth="0.0" maxWidth="Infinity">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label text="GARDEN" styleClass="caption"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox fx:id="legend" alignment="CENTER_RIGHT" spacing="14.0"/>
                    </HBox>
                </VBox>

                <VBox styleClass="card" spacing="12.0" minWidth="400.0" prefWidth="400.0">
                    <Label text="SELECTED" styleClass="caption"/>
                    <Label fx:id="selectedDateLabel" styleClass="selected-date"/>
                    <Label fx:id="selectedStateLabel" styleClass="small-muted"/>
                    <Region styleClass="divider"/>

                    <Label fx:id="aboveLabel" styleClass="caption"/>
                    <VBox fx:id="activityList" spacing="12.0"/>
                    <Label fx:id="capNote" styleClass="cap-note" maxWidth="Infinity"/>
                    <Region styleClass="divider"/>

                    <Label fx:id="belowLabel" styleClass="caption"/>
                    <VBox fx:id="restList" spacing="12.0"/>
                    <Label fx:id="goalLabel" styleClass="small-muted"/>
                </VBox>
            </HBox>

        <!-- Row 2: rewards to claim, and the streak. Two equal columns. -->
            <GridPane hgap="24.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50.0"/>
                    <ColumnConstraints percentWidth="50.0"/>
                </columnConstraints>
                <VBox styleClass="card" spacing="14.0" maxWidth="Infinity" maxHeight="Infinity"
                      GridPane.columnIndex="0">
                    <Label text="Rewards summary" styleClass="card-title"/>
                    <HBox alignment="CENTER_LEFT" spacing="14.0">
                        <Label text="Rewards ready to claim" styleClass="body" HBox.hgrow="ALWAYS"
                               minWidth="-Infinity" maxWidth="Infinity"/>
                        <Label fx:id="readyToClaimLabel" styleClass="count"/>
                    </HBox>
                    <Button text="View claiming page  →" styleClass="link-row"
                            minWidth="-Infinity" maxWidth="Infinity" onAction="#onViewClaiming"/>
                </VBox>

                <VBox styleClass="card" spacing="8.0" maxWidth="Infinity" maxHeight="Infinity"
                      GridPane.columnIndex="1">
                    <Label text="STREAK" styleClass="caption"/>
                    <HBox alignment="BASELINE_LEFT" spacing="8.0">
                        <Label fx:id="streakNumber" styleClass="streak-number"/>
                        <Label fx:id="streakUnit" styleClass="body"/>
                    </HBox>
                    <Label text="Anything logged keeps it going." wrapText="true" styleClass="small-muted"/>
                    <Region fx:id="streakDivider" styleClass="divider">
                        <VBox.margin>
                            <Insets top="10.0" bottom="6.0"/>
                        </VBox.margin>
                    </Region>
                    <HBox fx:id="milestoneRow" alignment="BASELINE_LEFT" spacing="4.0">
                        <Label text="Next milestone:" styleClass="body"/>
                        <Label fx:id="milestoneValue" styleClass="milestone-value"/>
                    </HBox>
                    <Label fx:id="startStreakLabel" text="Log anything today to start one." styleClass="body"/>
                </VBox>
            </GridPane>
        </VBox>

        <Label fx:id="messageLabel" wrapText="true" styleClass="error"/>
    </VBox>
</ScrollPane>
