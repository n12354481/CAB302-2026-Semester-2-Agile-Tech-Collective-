<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="com.example.cab302project.HelloController"
            xmlns:fx="http://javafx.com/fxml"
            styleClass="theme" stylesheets="@Theme.css"
            prefWidth="1100.0" prefHeight="700.0">
    <left>
        <VBox prefWidth="220.0" spacing="4.0" styleClass="sidebar">
            <padding>
                <Insets top="28.0" right="16.0" bottom="24.0" left="16.0"/>
            </padding>

            <Label text="Stemwise" styleClass="brand">
                <padding>
                    <Insets left="14.0" bottom="32.0"/>
                </padding>
            </Label>

            <Button text="Home" fx:id="homeButton" onAction="#onHomeButtonClicked"
                    maxWidth="Infinity" styleClass="nav-item"/>
            <Button text="Check-in" fx:id="checkInButton" onAction="#onCheckInButtonClicked"
                    maxWidth="Infinity" styleClass="nav-item"/>
            <Button text="Activities" fx:id="activitiesButton" onAction="#onActivitiesButtonClicked"
                    maxWidth="Infinity" styleClass="nav-item"/>
            <Button text="Social" fx:id="socialButton" onAction="#onSocialButtonClicked"
                    maxWidth="Infinity" styleClass="nav-item"/>
            <Button text="Rewards" fx:id="rewardsButton" onAction="#onRewardsButtonClicked"
                    maxWidth="Infinity" styleClass="nav-item"/>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <padding>
                    <Insets left="14.0" top="16.0" bottom="8.0"/>
                </padding>
                <StackPane minWidth="32.0" prefWidth="32.0" maxWidth="32.0"
                           minHeight="32.0" prefHeight="32.0" maxHeight="32.0" styleClass="avatar">
                    <Label fx:id="usernameInitials" styleClass="avatar-text"/>
                </StackPane>
                <Label fx:id="usernameDisplay" styleClass="nav-name"/>
            </HBox>

            <Button text="Settings" fx:id="settingsButton" onAction="#onSettingsButtonClicked"
                    maxWidth="Infinity" styleClass="nav-item"/>
            <Button text="Logout" fx:id="logoutButton" onAction="#onLogoutButtonClicked"
                    maxWidth="Infinity" styleClass="nav-item"/>
        </VBox>
    </left>

    <!-- Scrolls when a page is taller than the window, so the sidebar always fits. -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="scroll-clear">
            <StackPane fx:id="mainContent"/>
        </ScrollPane>
    </center>
</BorderPane>
