<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets ?>
<?import javafx.scene.image.ImageView?>


<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.cab302project.Activities.ActivitiesController"
           prefWidth="900"
           prefHeight="650"
           style="-fx-background-color: white;">
    <fx:define>
        <ToggleGroup fx:id="durationGroup"/>
    </fx:define>

    <VBox fx:id="browsePane" visible="true" managed="true" spacing="20">
        <padding>
            <Insets top="30" right="35" bottom="30" left="35"/>
        </padding>

        <Label text="Activities" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        <Label text="Choose an activity to support your wellbeing." wrapText="true" style="-fx-font-size: 15px; -fx-text-fill: #666666;"/>

        <ButtonBar fx:id="buttonBar"/>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" style="-fx-background: white; -fx-background-color: white;">
            <content>
                <FlowPane fx:id="contentPane" hgap="20" vgap="20" prefWrapLength="750">
                    <padding>
                        <Insets top="10" right="10" bottom="25" left="10"/>
                    </padding>
                </FlowPane>
            </content>
        </ScrollPane>
    </VBox>

    <ScrollPane fx:id="detailsPane" visible="false" managed="false" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: white; -fx-background-color: white;">
        <content>
            <VBox spacing="18">
                <padding>
                    <Insets top="30" right="40" bottom="30" left="40"/>
                </padding>

                <Button text="← Back" onAction="#onBackClicked" prefWidth="90" style="-fx-background-color: #E8EEEE; -fx-background-radius: 8; -fx-cursor: hand;"/>

                <StackPane prefHeight="250" minHeight="250" maxHeight="250" style="-fx-background-color: #E8EEEE; -fx-background-radius: 15;">
                    <ImageView fx:id="activityImage" fitWidth="600" fitHeight="240" preserveRatio="true"/>
                    <Label fx:id="imagePlaceholder" style="-fx-font-size: 20px; -fx-text-fill: #666666;"/>
                </StackPane>

                <Label fx:id="activityName" wrapText="true" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

                <Label fx:id="categoryLabel" style="-fx-background-color: #E8EEEE; -fx-padding: 6 12; -fx-background-radius: 12; -fx-font-size: 14px;"/>

                <Label fx:id="descriptionLabel" wrapText="true" maxWidth="700" style="-fx-font-size: 15px; -fx-line-spacing: 3;"/>

                <Label fx:id="goalLabel" style="-fx-font-size: 17px; -fx-font-weight: bold;"/>
                <Separator/>

                <Label text="Choose duration" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                <FlowPane hgap="20" vgap="10">
                    <RadioButton text="15 mins" toggleGroup="$durationGroup"/>
                    <RadioButton text="30 mins" toggleGroup="$durationGroup"/>
                    <RadioButton fx:id="customDuration" text="custom" toggleGroup="$durationGroup"/>
                </FlowPane>
                <TextField fx:id="customMinutes" promptText="Duratin in minutes" maxWidth="220"/>
                <Button text="Select Activity" onAction="#onSelectActivityClicked" prefWidth="180" prefHeight="42" style="-fx-background-color: #386F65;-fx-text-fill: white;-fx-font-size: 15px;-fx-font-weight: bold;-fx-background-radius: 8; -fx-cursor: hand;"/>
                <Label fx:id="selectionMessage" wrapText="true" style="-fx-font-size: 14px; -fx-text-fill: #386F65;"/>
            </VBox>
        </content>
    </ScrollPane>
</StackPane>